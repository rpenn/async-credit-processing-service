# Copy to .env and change the password: cp .env.example .env
# Docker Compose reads .env automatically. .env is git-ignored; never commit it.

# RabbitMQ login, used by the services and the management UI (http://localhost:15672).
RABBITMQ_USER=credit
RABBITMQ_PASSWORD=change-me

# Optional. Largest amount one credit may have, with at most 2 decimal places.
# MAX_CREDIT_AMOUNT=1000000.00
