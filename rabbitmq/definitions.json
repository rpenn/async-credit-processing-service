{
  "policies": [
    {
      "vhost": "/",
      "name": "credits",
      "pattern": "^credits$",
      "apply-to": "quorum_queues",
      "priority": 0,
      "definition": {
        "delivery-limit": 5,
        "dead-letter-exchange": "credits.dead-letter",
        "dead-letter-strategy": "at-least-once",
        "overflow": "reject-publish"
      }
    }
  ],
  "exchanges": [
    {
      "vhost": "/",
      "name": "credits.dead-letter",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "vhost": "/",
      "name": "credits.dead-letter",
      "durable": true,
      "auto_delete": false,
      "arguments": { "x-queue-type": "quorum" }
    }
  ],
  "bindings": [
    {
      "vhost": "/",
      "source": "credits.dead-letter",
      "destination": "credits.dead-letter",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ]
}
